  {"name": "file brief_hour null = off", "boring": {"schedule": {"brief_hour": null}}, "env": {}, "expect": {"schedule": {"brief_hour": null}}},
  {"name": "file ingest_tick_minutes", "boring": {"schedule": {"ingest_tick_minutes": 10}}, "env": {}, "expect": {"schedule": {"ingest_tick_minutes": 10}}},
  {"name": "file queue_per_tick", "boring": {"schedule": {"queue_per_tick": 7}}, "env": {}, "expect": {"schedule": {"queue_per_tick": 7}}},
