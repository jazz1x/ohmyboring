   "expect": {"schedule": {"brief_hour": null, "brief_hour_error": "brief_hour 잘못된 값: abc", "sync_hours": 4}}},
  {"name": "env BORING_BRIEF_HOUR 24 = off + reported", "boring": {}, "env": {"BORING_BRIEF_HOUR": "24"},
   "expect": {"schedule": {"brief_hour": null, "brief_hour_error": "brief_hour 잘못된 값: 24"}}},
  {"name": "env BORING_BRIEF_HOUR -1 = off + reported", "boring": {}, "env": {"BORING_BRIEF_HOUR": "-1"},
   "expect": {"schedule": {"brief_hour": null, "brief_hour_error": "brief_hour 잘못된 값: -1"}}},
