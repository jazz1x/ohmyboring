  {"name": "env INGEST_PENDING_TTL", "boring": {}, "env": {"INGEST_PENDING_TTL": "601"}, "expect": {"collect": {"pending_ttl_seconds": 601}}},
  {"name": "env COLLECT_RETRY_TTL", "boring": {"collect": {"retry_ttl_seconds": 5}}, "env": {"COLLECT_RETRY_TTL": "900"}, "expect": {"collect": {"retry_ttl_seconds": 900}}},
  {"name": "env INGEST_RETRY_TTL", "boring": {}, "env": {"INGEST_RETRY_TTL": "901"}, "expect": {"collect": {"retry_ttl_seconds": 901}}}
